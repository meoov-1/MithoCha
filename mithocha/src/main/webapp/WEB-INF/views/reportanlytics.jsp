<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MithoCha Report Analytics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/app.css">
</head>
<body>
<main class="content-shell">
    <div class="content-wrap">
        <section class="page-hero">
            <p class="page-tag">Analytics</p>
            <h1 class="page-title">Analytics Placeholder</h1>
            <p class="page-copy">All chart bars, percentages, and trend labels have been removed. Replace the placeholders below with backend analytics results.</p>
        </section>
        <section class="placeholder-grid">
            <article class="page-card placeholder-stack">
                <h2 class="placeholder-title">Sales Metrics</h2>
                <p class="placeholder-copy" data-field="analyticsSalesMetric">Pending database value</p>
                <p class="placeholder-copy" data-field="analyticsSalesTrend">Pending database value</p>
            </article>
            <article class="page-card placeholder-stack">
                <h2 class="placeholder-title">Customer Metrics</h2>
                <p class="placeholder-copy" data-field="analyticsCustomerMetric">Pending database value</p>
                <p class="placeholder-copy" data-field="analyticsCustomerTrend">Pending database value</p>
            </article>
        </section>
        <section class="page-card placeholder-stack">
            <h2 class="placeholder-title">Report Table</h2>
            <table class="placeholder-table">
                <thead><tr><th>Label</th><th>Value</th><th>Notes</th></tr></thead>
                <tbody><tr><td data-field="reportLabel">--</td><td data-field="reportValue">--</td><td data-field="reportNotes">--</td></tr></tbody>
            </table>
        </section>
    </div>
</main>
</body>
</html>
