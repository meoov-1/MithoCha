<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>MithoCha Web Application</display-name>

  <!-- ===== USER PAGES ===== -->
  <servlet>
    <servlet-name>dashboard</servlet-name>
    <jsp-file>/WEB-INF/views/user/home.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>login</servlet-name>
    <jsp-file>/WEB-INF/views/user/login.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>register</servlet-name>
    <jsp-file>/WEB-INF/views/user/register.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>products</servlet-name>
    <jsp-file>/WEB-INF/views/user/products.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>product-detail</servlet-name>
    <jsp-file>/WEB-INF/views/user/product-detail.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>cart</servlet-name>
    <jsp-file>/WEB-INF/views/user/cart.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>billing</servlet-name>
    <jsp-file>/WEB-INF/views/user/billing.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>profile</servlet-name>
    <jsp-file>/WEB-INF/views/user/profile.jsp</jsp-file>
  </servlet>

  <!-- ===== ADMIN PAGES ===== -->
  <servlet>
    <servlet-name>admin-dashboard</servlet-name>
    <jsp-file>/WEB-INF/views/admin/admin-dashboard.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>customermanagement</servlet-name>
    <jsp-file>/WEB-INF/views/admin/customermanagement.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>inventory</servlet-name>
    <jsp-file>/WEB-INF/views/admin/inventory.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>menumanagement</servlet-name>
    <jsp-file>/WEB-INF/views/admin/menumanagement.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>offerdiscount</servlet-name>
    <jsp-file>/WEB-INF/views/admin/offerdiscount.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>ordermanagement</servlet-name>
    <jsp-file>/WEB-INF/views/admin/ordermanagement.jsp</jsp-file>
  </servlet>

  <servlet>
    <servlet-name>reportanlytics</servlet-name>
    <jsp-file>/WEB-INF/views/admin/reportanlytics.jsp</jsp-file>
  </servlet>
  <!-- Add inside admin pages section -->
  <servlet>
    <servlet-name>admin-billing</servlet-name>
    <jsp-file>/WEB-INF/views/admin/billing.jsp</jsp-file>
  </servlet>


  <!-- ===== USER MAPPINGS ===== -->
  <servlet-mapping>
    <servlet-name>dashboard</servlet-name>
    <url-pattern>/dashboard</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>register</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>products</servlet-name>
    <url-pattern>/products</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>product-detail</servlet-name>
    <url-pattern>/product-detail</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>cart</servlet-name>
    <url-pattern>/cart</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>billing</servlet-name>
    <url-pattern>/billing</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>profile</servlet-name>
    <url-pattern>/profile</url-pattern>
  </servlet-mapping>

  <!-- ===== ADMIN MAPPINGS ===== -->
  <servlet-mapping>
    <servlet-name>admin-dashboard</servlet-name>
    <url-pattern>/admin-dashboard</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>customermanagement</servlet-name>
    <url-pattern>/customermanagement</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>inventory</servlet-name>
    <url-pattern>/inventory</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>menumanagement</servlet-name>
    <url-pattern>/menumanagement</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>offerdiscount</servlet-name>
    <url-pattern>/offerdiscount</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>ordermanagement</servlet-name>
    <url-pattern>/ordermanagement</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>reportanlytics</servlet-name>
    <url-pattern>/reportanlytics</url-pattern>
  </servlet-mapping>
  <!-- Add inside admin mappings section -->
  <servlet-mapping>
    <servlet-name>admin-billing</servlet-name>
    <url-pattern>/admin-billing</url-pattern>
  </servlet-mapping>
  <!-- ===== WELCOME PAGE ===== -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

</web-app>
